{
  "name": "shadowstrike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SHADOWSTRIKE \u2014 a camera-driven shadow fighting game. Your real body is the controller.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "server": "node server/index.js",
    "start": "concurrently -n web,net -c cyan,magenta \"npm:dev\" \"npm:server\"",
    "fetch:models": "node scripts/fetch-models.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^0.10.22"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "ws": "^8.18.0"
  }
}
